# Free key: https://api.census.gov/data/key_signup.html
# Without a key the app reads the Census "Download Data Sets" file instead (same data).
CENSUS_API_KEY=
DATABASE_URL="file:./dev.db"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PowerGraphs <reports@powergraphs.com>"

# optional: if set, the whole site requires this password
APP_PASSWORD=
NEXT_PUBLIC_SITE_NAME=PowerGraphs
# empty now; later e.g. "/powergraphs" inside PowerBanks.com
NEXT_PUBLIC_BASE_PATH=
